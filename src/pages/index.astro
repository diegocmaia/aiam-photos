---
import { fetchPhotos } from '../lib/contentful';

const photos = await fetchPhotos();
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>aiam photos</title>
    <style>
        body {
            margin: 8px;
            padding: 0;
            display: flex;
            justify-content: center;
        }
        .gallery {
            width: 100%;
            max-width: 1920px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            box-sizing: border-box;
        }
        .photo-container {
            width: 100%;
            display: flex;
            justify-content: center;
        }
        .photo-container img {
            max-width: 100%;
            max-height: 90vh;
            height: auto;
            width: auto;
            display: block;
        }
        h1 {
            padding: 1rem;
            margin: 0;
        }
    </style>
</head>
<body>
    <div class="gallery">
        {photos.map((photo) => (
            <div class="photo-container">
                <img 
                    src={`https:${photo.imageUrl}`} 
                    alt={photo.title || 'Photo'}
                    loading="lazy"
                    onload="this.style.maxWidth = this.naturalWidth > this.naturalHeight ? '100%' : '60%'"
                />
            </div>
        ))}
    </div>

    <script>
        // Handle images that are already loaded when the page loads
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.photo-container img').forEach((img) => {
                if ((img as HTMLImageElement).complete) {
                    const imgElement = img as HTMLImageElement;
                    imgElement.style.maxWidth = imgElement.naturalWidth > imgElement.naturalHeight ? '100%' : '60%';
                }
            });
        });
    </script>
</body>
</html>